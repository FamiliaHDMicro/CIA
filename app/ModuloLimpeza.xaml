<Window x:Class="NexusAdminTool.ModuloLimpeza"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ControlIA — Limpeza do disco"
        Width="720" Height="560" MinWidth="340" MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txtResumo" Grid.Row="0" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,8"/>
        <ListBox x:Name="lista" Grid.Row="1" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding Marcado}" Margin="2,4">
                        <TextBlock Text="{Binding Texto}" TextWrapping="Wrap"/>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right">
            <Button x:Name="btnVarrer" Content="Varrer de novo" Click="btnVarrer_Click" MinWidth="130" Padding="12,6" Margin="6,0,0,0"/>
            <Button x:Name="btnLimpar" Content="Limpar os marcados" Click="btnLimpar_Click" MinWidth="150" Padding="12,6" Margin="6,0,0,0"/>
            <Button Content="Fechar" Click="btnFechar_Click" MinWidth="100" Padding="12,6" Margin="6,0,0,0"/>
        </WrapPanel>
    </Grid>
</Window>
