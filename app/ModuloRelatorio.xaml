<Window x:Class="NexusAdminTool.ModuloRelatorio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ControlIA — Meus sinais vitais"
        Width="780" Height="640"
        MinWidth="360" MinHeight="360"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="CIA — Relatório de sinais vitais"
                   FontSize="20" FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <!-- Cresce e encolhe junto com a janela; rola quando o texto não cabe. -->
        <TextBox Grid.Row="1"
                 x:Name="txtRelatorio"
                 IsReadOnly="True"
                 FontFamily="Consolas" FontSize="13"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Padding="8"/>

        <!-- Os botões descem para a linha de baixo quando a janela fica estreita. -->
        <WrapPanel Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right">
            <Button x:Name="btnEnviarCloud" Content="Enviar ao servidor"
                    Click="btnEnviarCloud_Click"
                    MinWidth="140" Padding="12,6" Margin="6,0,0,0"/>
            <Button x:Name="btnExportarTxt" Content="Salvar como .txt"
                    Click="btnExportarTxt_Click"
                    MinWidth="140" Padding="12,6" Margin="6,0,0,0"/>
            <Button x:Name="btnVoltar" Content="Fechar"
                    Click="btnVoltar_Click"
                    MinWidth="100" Padding="12,6" Margin="6,0,0,0"/>
        </WrapPanel>
    </Grid>
</Window>
