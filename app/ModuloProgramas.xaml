<Window x:Class="NexusAdminTool.ModuloProgramas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ControlIA — Programas instalados"
        Width="760" Height="600" MinWidth="340" MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txtResumo" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <ListBox x:Name="lista" Grid.Row="1" SelectionChanged="lista_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" Margin="2,2"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="txtDetalhe" Grid.Row="2" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <WrapPanel Grid.Row="3" Margin="0,10,0,0" HorizontalAlignment="Right">
            <Button x:Name="btnDesinstalar" Content="Desinstalar o selecionado" Click="btnDesinstalar_Click"
                    IsEnabled="False" MinWidth="190" Padding="12,6" Margin="6,0,0,0"/>
            <Button Content="Fechar" Click="btnFechar_Click" MinWidth="100" Padding="12,6" Margin="6,0,0,0"/>
        </WrapPanel>
    </Grid>
</Window>
