# MODELO. Só use se um dia for publicar com "wrangler deploy".
# Copie para wrangler.toml e troque os dois IDs abaixo pelos do seu painel Cloudflare.
# A senha do painel (ADMIN_TOKEN) NUNCA vai neste arquivo: ela fica em Variáveis e segredos.
name = "control-ia"
main = "worker.js"
compatibility_date = "2026-10-01"

[[kv_namespaces]]
binding = "LICENCAS_KV"
id = "COLE_AQUI_O_ID_DO_KV"

[[d1_databases]]
binding = "DB"
database_name = "controlia"
database_id = "4f509b72-2405-4c47-9ae2-744cf52cad08"

# Para rodar a rotina diária de técnicos expirados, descomente:
# [triggers]
# crons = ["0 6 * * *"]
